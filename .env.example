# General
NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:8081

# OTP delivery. Use development locally: the API returns a temporary code and sends no email.
# Keep this as development until an email provider integration is implemented.
OTP_DELIVERY_MODE=development

# Database connection will be consumed after the migration runner is added.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/docconnect_dev

# Mobile app: replace this with your computer's LAN IP when testing in Expo Go.
# Do not use localhost from a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000/api/v1
