# General
NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:8081

# OTP delivery. Use development locally: the API returns a temporary code and sends no email.
# Keep this as development until an email provider integration is implemented.
OTP_DELIVERY_MODE=development

# JWT access-token settings for the API Gateway.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d

# Database runtime URL. Use the pooled Prisma Postgres connection URL.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Direct connection URL, used only by Prisma migrations and Prisma Studio.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Mobile app: replace this with your computer's LAN IP when testing in Expo Go.
# Do not use localhost from a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
