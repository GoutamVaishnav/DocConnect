{
  "name": "docconnect",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner-friendly telemedicine application monorepo.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @docconnect/mobile",
    "gateway": "npm run dev --workspace @docconnect/api-gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:mobile": "npm run lint --workspace @docconnect/mobile"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  }
}
