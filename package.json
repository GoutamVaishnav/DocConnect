{
  "name": "docconnect",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner-friendly telemedicine application monorepo.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @docconnect/mobile run start --",
    "mobile:tunnel": "npm --workspace @docconnect/mobile run start -- --tunnel",
    "gateway": "npm run dev --workspace @docconnect/api-gateway",
    "database:generate": "npm run generate --workspace @docconnect/database",
    "database:migrate": "npm run migrate:dev --workspace @docconnect/database",
    "database:studio": "npm run studio --workspace @docconnect/database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:mobile": "npm run lint --workspace @docconnect/mobile"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  }
}
