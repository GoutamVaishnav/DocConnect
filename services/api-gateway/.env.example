NODE_ENV=development
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:8081
OTP_DELIVERY_MODE=development

# Set OTP_DELIVERY_MODE=smtp to send real emails. Get these values from your
# email provider's SMTP settings. SMTP_SECURE=true is normally used with port
# 465; use SMTP_SECURE=false for STARTTLS on port 587.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM="DocConnect <no-reply@your-domain.com>"

# Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d

# Copy these values from Cloudinary Console > API Keys. Keep API_SECRET only here
# on the gateway/server; never put it in the Expo/mobile app.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Copy the same pooled runtime URL from services/database/.env when the Gateway
# starts using Prisma-backed models.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
